{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "es2024": true,
    "webextensions": true
  },
  "ignorePatterns": ["dist/**", "build/**", "node_modules/**", "src/phosphor-icons.ts"]
}
